@model HotelmasCarga.Models.DisponibilidadHabitacion

@{
    ViewData["Title"] = "Eliminar Disponibilidad";
}

<div class="container mt-3">
    <h2>Eliminar Disponibilidad</h2>
    <div class="alert alert-warning">¿Confirma eliminar esta disponibilidad?</div>
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Habitación</dt>
        <dd class="col-sm-10">@Model.Habitacion?.Numero</dd>
        <dt class="col-sm-2">Disponible</dt>
        <dd class="col-sm-10">@(Model.EstaDisponible ? "Sí" : "No")</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdDisponibilidad" />
        <button class="btn btn-danger" type="submit">Eliminar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </form>
</div>
