@model HotelmasCarga.Models.DisponibilidadHabitacion

@{
    ViewData["Title"] = "Detalles Disponibilidad";
}

<div class="container mt-3">
    <h2>Detalles</h2>
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Habitación</dt>
        <dd class="col-sm-10">@Model.Habitacion?.Numero</dd>

        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Model.Habitacion?.TipoHabitacion?.Nombre</dd>

        <dt class="col-sm-2">Disponible</dt>
        <dd class="col-sm-10">@(Model.EstaDisponible ? "Sí" : "No")</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.IdDisponibilidad" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</div>
