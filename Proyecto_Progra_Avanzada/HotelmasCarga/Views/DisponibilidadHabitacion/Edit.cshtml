@model HotelmasCarga.Models.DisponibilidadHabitacion

@{
    ViewData["Title"] = "Editar Disponibilidad";
}

<div class="container mt-3">
    <h2>Editar Disponibilidad</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdDisponibilidad" />
        <div class="form-group">
            <label>Fecha</label>
            <input asp-for="Fecha" class="form-control" type="date" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Habitación</label>
            @Html.DropDownList("IdHabitacion", (SelectList)ViewData["Habitaciones"], "-- Seleccione --", new { @class = "form-control" })
            <span asp-validation-for="IdHabitacion" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input asp-for="EstaDisponible" class="form-check-input" />
            <label asp-for="EstaDisponible" class="form-check-label">Está disponible</label>
        </div>
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a asp-action="Index" class="btn btn-link">Volver</a>
    </form>
</div>
