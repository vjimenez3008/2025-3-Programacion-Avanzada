@model HotelmasCarga.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<h1>Eliminar</h1>

<h3>¿Está seguro de que desea eliminar esta reserva?</h3>

<div>
    <h4>Reserva</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.FechaReserva.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">@Model.Cliente?.Nombre</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdReserva" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
