@model HotelmasCarga.Models.TipoHabitacion
@{
    ViewData["Title"] = "Delete Room Type";
}

<h1>Delete</h1>
<div class="alert alert-danger">
    Are you sure you want to delete this?
</div>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Descripcion</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdTipoHabitacion" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
