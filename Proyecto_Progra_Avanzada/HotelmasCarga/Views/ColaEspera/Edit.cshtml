@model HotelmasCarga.Models.ColaEspera

@{
    ViewData["Title"] = "Editar Cola de Espera";
}

<div class="container mt-3">
    <h2>Editar</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdCola" />
        <div class="form-group">
            <label>Cliente</label>
            @Html.DropDownList("IdCliente", (SelectList)ViewData["Clientes"], "-- Seleccione --", new { @class = "form-control" })
        </div>
        <div class="form-group">
            <label>Tipo</label>
            @Html.DropDownList("IdTipoHabitacion", (SelectList)ViewData["Tipos"], "-- Seleccione --", new { @class = "form-control" })
        </div>
        <div class="form-group">
            <label>Fecha Deseada</label>
            <input asp-for="FechaDeseada" type="date" class="form-control" />
        </div>
        <div class="form-group">
            <label>Estado</label>
            <input asp-for="Estado" class="form-control" />
        </div>
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a asp-action="Index" class="btn btn-link">Volver</a>
    </form>
</div>
