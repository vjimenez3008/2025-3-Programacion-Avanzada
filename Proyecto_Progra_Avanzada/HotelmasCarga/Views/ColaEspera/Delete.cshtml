@model HotelmasCarga.Models.ColaEspera

@{
    ViewData["Title"] = "Eliminar Cola de Espera";
}

<div class="container mt-3">
    <h2>Eliminar</h2>
    <div class="alert alert-warning">¿Confirma eliminar este registro de la lista de espera?</div>
    <dl class="row">
        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">@Model.Cliente?.Nombre</dd>
        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Model.TipoHabitacion?.Nombre</dd>
        <dt class="col-sm-2">Fecha Deseada</dt>
        <dd class="col-sm-10">@Model.FechaDeseada.ToString("yyyy-MM-dd")</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdCola" />
        <button class="btn btn-danger" type="submit">Eliminar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </form>
</div>
