@model HotelmasCarga.Models.Habitacion

@{
    ViewData["Title"] = "Detalle Habitación";
}

<h1>Detalle</h1>

<div>
    <h4>Habitación</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Número</dt>
        <dd class="col-sm-10">@Model.Numero</dd>

        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Model.TipoHabitacion?.Nombre</dd>

        <dt class="col-sm-2">Activa</dt>
        <dd class="col-sm-10">@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
