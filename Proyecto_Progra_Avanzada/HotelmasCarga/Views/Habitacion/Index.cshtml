@model IEnumerable<HotelmasCarga.Models.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear nueva</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Activa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Numero</td>
            <td>@item.TipoHabitacion?.Nombre</td>
            <td>@(item.Activa ? "Sí" : "No")</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.IdHabitacion">Editar</a>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdHabitacion">Detalles</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.IdHabitacion">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
